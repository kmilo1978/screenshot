# =============================================================================
# screenshot-to-code Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# You need AT LEAST ONE of: OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY.
# For best results, Gemini + Replicate are strongly recommended.
# =============================================================================

# --- LLM Provider Keys (at least one required) ---

# OpenAI - enables GPT models (GPT-5.5, GPT-5.4 Mini)
OPENAI_API_KEY=

# Anthropic - enables Claude models (Opus, Sonnet)
ANTHROPIC_API_KEY=

# Google Gemini - enables Gemini models + asset extraction + video mode
# STRONGLY RECOMMENDED
GEMINI_API_KEY=

# --- Image Generation (optional but recommended) ---

# Replicate - enables image editing, background removal, image generation
# STRONGLY RECOMMENDED
REPLICATE_API_KEY=

# --- NVIDIA NIM (optional, OpenAI-compatible) ---

# Enables NVIDIA NIM models (Llama, Nemotron, etc.) via build.nvidia.com
NVIDIA_API_KEY=

# --- Optional Configuration ---

# Custom OpenAI-compatible base URL (must include /v1 in path)
# Example: https://your-proxy.example.com/v1
# OPENAI_BASE_URL=

# Enable debug mode (writes debug info to DEBUG_DIR)
# IS_DEBUG_ENABLED=false
# DEBUG_DIR=

# Enable prompt reports (writes LLM requests to run_logs/prompt_reports)
# PROMPT_REPORTS_ENABLED=false

# Directory for locally extracted assets
# LOCAL_ASSET_DIR=./local_assets

# Base URL for serving local assets (default: http://127.0.0.1:7001)
# LOCAL_ASSET_BASE_URL=http://127.0.0.1:7001

# Set to true for production/hosted mode
# IS_PROD=false
